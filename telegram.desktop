[Desktop Entry]
Name=Telegram (Podman)
Comment=Telegram Desktop in a rootless Podman jail
# Install under Telegram's Wayland app ID as file name, see README.
Exec=@DIR@/launch.sh %u
Path=@DIR@
Icon=telegram
Terminal=false
Type=Application
StartupWMClass=TelegramDesktop
Categories=Chat;Network;InstantMessaging;Qt;
Keywords=tg;chat;im;messaging;messenger;
MimeType=x-scheme-handler/tg;
Actions=stop;

[Desktop Action stop]
Name=Stop Telegram
Exec=/usr/bin/podman compose down
Icon=media-playback-stop
